{
  "name": "nurmanos-agentic-memory",
  "version": "0.1.0",
  "private": false,
  "description": "Agentic memory for synthetic nursing-supervision workflows, powered by CockroachDB and AWS.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:frontend && pnpm build:lambda",
    "build:frontend": "vite build",
    "build:lambda": "esbuild src/lambda/handler.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/lambda/index.js --external:pg-native --sourcemap",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.864.0",
    "@aws-sdk/client-secrets-manager": "^3.864.0",
    "@smithy/types": "^4.3.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^22.17.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "22.14.0",
    "pnpm": "10.15.0"
  },
  "packageManager": "pnpm@10.15.0"
}
